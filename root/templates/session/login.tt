<div class="mx-auto" style="max-width:500px;">
    <div class="content-box mb-3">
        <div class="text-center mb-3">
            <h2>Sign in</h2>
        </div>

        <form method="post" action="[% post_login_url %]" class="d-flex flex-column gap-3">
            <div class="form-floating">
                <input type="text" id="floatingUsername" name="username" placeholder="username" [% 'autofocus' IF NOT username %] value="[% username | html %]" class="form-control">
                <label for="floatingUsername">Username</label>
            </div>
            <div class="d-flex flex-column">
                <div class="form-floating">
                    <input type="password" id="floatingPassword"  name="password" placeholder="password" [% 'autofocus' IF username %] value="" class="form-control">
                    <label for="floatingPassword">Password</label>
                </div>
                <a class="text-end" href="[% recover_url %]">Lost your password?</a>
            </div>
            <div class="form-check m-0">
                <input id="store_username" class="form-check-input" type="checkbox" name="store_username" [% 'checked' IF store_username %]>
                <label for="store_username">Remember username for next login</label>
            </div>
            <input type="submit" value="Sign in" class="btn btn-primary">
        </form>
    </div>

    [% IF register_url %]
        <div class="content-box mb-3">
            <p class="m-0 text-center">You don’t have an account yet? <a href="[% register_url %]">Sign up now!</a></p>
        </div>
    [% END %]
</div>
