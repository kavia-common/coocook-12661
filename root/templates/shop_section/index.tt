[% title = "Shop sections";

js_push_template_path() %]

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Number of Articles</th>
            <th class="btn-icon-2"></th>
        </tr>
    </thead>
    <tbody>
        [% FOREACH section IN shop_sections %]
        <tr>
            <td>[% section.name | html %]</td>
            <td>[% section.article_count %]</td>
            <td>
                <div class="d-flex">
                    <button class="btn btn-outline-dark btn-sm btn-quad update" title="Rename shop section" data-url="[% section.update_url %]" data-name="[% section.name | html %]"  data-bs-toggle="modal" data-bs-target="#updateSection">
                        <i class="material-icons">edit</i>
                    </button>
                    [% IF section.delete_url %]
                    <form class="ms-1" action="[% section.delete_url %]" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm btn-quad" title="Delete shop section">
                            <i class="material-icons">delete_forever</i>
                        </button>
                    </form>
                    [% END %]
                </div>
            </td>
        </tr>
        [% END %]
        <tr>
            <td colspan="3">
                <div class="d-grid">
                    <button class="btn btn-outline-primary material-icons" data-bs-toggle="modal" data-bs-target="#addSection">add</button>
                </div>
            </td>
        </tr>
    </tbody>
</table>

<form id="update-section" method="post" action="">
    <div class="modal fade" id="updateSection" tabindex="-1" aria-labelledby="updateSectionLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateSectionLabel">Rename shop section <i id="section-name"></i></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="ss-new-name" class="form-label">New name</label>
                        <input id="ss-new-name" class="form-control" type="text" name="name" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Rename shop section</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form method="post" action="[% create_url %]">
    <div class="modal fade" id="addSection" tabindex="-1" aria-labelledby="addSectionLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addSectionLabel">Create shop section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="ss-name" class="form-label">Name</label>
                        <input id="ss-name" class="form-control" type="text" name="name" value="[% last_input.name %]" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Create shop section</button>
                </div>
            </div>
        </div>
    </div>
</form>

[% WRAPPER includes/infobox.tt %]
    A <em>shop section</em> is a category for articles that can be purchased.
    You can group articles on purchase lists by selecting the shop section for them.
[% END %]
