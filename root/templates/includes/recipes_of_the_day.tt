[% IF recipes_of_the_day.size > 0 %]
<h2>[% recipes_of_the_day.size == 1 ? 'Recipe' : 'Recipes' %] of the day</h2>

<ul class="list-unstyled d-flex flex-wrap gap-3">
[% FOR rotd IN recipes_of_the_day %]
    <li><a class="item-box text-white" href="[% rotd.url %]">[% rotd.recipe.name | html %]</a></li>
[% END %]
</ul>
[% END %]
