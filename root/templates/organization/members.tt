[% escape_title( 'Organization members of', organization.display_name ) %]

<p><a href="[% organization_url %]">Back to organization page</a></p>

<table>
    <thead>
        <tr>
            <th>User</th>
            <th>Role</th>
            <th>Actions</th>
    </thead>
    <tbody>
[% FOR g_u IN organizations_users %]
        <tr>
            <td>[% link_user(g_u.user, g_u.user_url) %]</td>
            <td>
    [% IF g_u.edit_url %]
                <form method="post" action="[% g_u.edit_url %]" class="inline">
                    <select name="role">
        [% FOR role IN roles %]
                        <option value="[% role %]" [% 'selected' IF g_u.role == role %]>[% role %]</option>
        [% END %]
                    </select>
                    <input type="submit" value="Save">
                </form>
    [% ELSE %]
                [% g_u.role %]
    [% END %]
            </td>
            <td>
                [% IF g_u.remove_url %]
                    <form class="inline" method="post" action="[% g_u.remove_url %]">
                        <input type="submit" value="Remove">
                    </form>
                [% END %]
                [% IF g_u.transfer_ownership_url %]
                    <form class="inline" name="transfer-ownership" method="post" action="[% g_u.transfer_ownership_url %]">
                        <input type="submit" value="Transfer ownership">
                    </form>
                [% END %]
            </td>
        </tr>
[% END %]
    </tbody>
</table>

<p>You need another member with role <em>admin</em> to transfer ownership to them.</p>

<div class="card my-3">
    <div class="card-header">
        <h3>Add member</h3>
    </div>
    <div class="card-body">
    [% IF other_users %]
        <div id="add-member-msg"></div>
        <form method="post" action="[% add_url %]" id="add-member">
            <div class="mb-2">
                <label for="user" class="form-label">User</label>
                <cc-autocomplete id="user" endpoint='{"url": "/autocomplete/users"}' render="renderUserOption" filter="filterUser" input-name="name" msg-func="alertMessage" invalid='["Please select an user", "danger", false, "add-member-msg"]'></cc-autocomplete>
            </div>
            <div class="mb-2">
                <label for="role" class="form-label">Role</label>
                <select id="role" class="form-control" name="role">
                [% FOR role IN roles %]
                    <option value="[% role %]">[% role %]</option>
                [% END %]
                </select>
            </div>
            <div class="d-flex justify-content-end">
                <input class="btn btn-primary" type="submit" value="Add">
            </div>
        </form>
    [% ELSE %]
        <p>No more users. You need to let users sign up before adding them to this organization.</p>
    [% END %]
    </div>
</div>
<script>
    function renderUserOption(data) {
        return [`👤 ${data.display_name} (${data.name})`, data.name];
    }
    userList = Array.from(document.querySelectorAll(".username"), elem => elem.innerText);
    function filterUser(data) {
        return data.filter(elem => !userList.includes(elem.name));
    }
</script>
