[% title = "Import";

js_push_template_path();

no_import = 1;
FOR p IN properties;
    IF !p.disabled;
        no_import = 0;
    END;
END;

IF no_import; %]
<p>Nothing can be imported to this project, because you already created your own stuff in all possible categories.</p>
[% ELSE %]
<form method="post" action="[% import_url %]" class="import">
    <div class="card mb-3">
        <div class="card-header">
            <h3>Source Project</h3>
        </div>

        <div class="card-body">
            <select class="form-control" name="source_project">
            [% FOR proj IN projects # don't overwrite $project %]
                <option value="[% proj.id %]">[% proj.name | html %]</option>
            [% END %]
            </select>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h3>Properties to import</h3>
        </div>

        <div class="card-body">
            <p id="jsWarning">Properties depend on each other. Enable JavaScript to resolve dependencies automatically.</p>
            [% FOR property IN properties %]
            <div class="form-check">
                <input class="form-check-input" id="property_[% property.key %]" name="property_[% property.key %]" type="checkbox" [% property.disabled ? 'disabled' : 'checked' %]>
                <label class="form-check-label" for="property_[% property.key %]">[% property.name | html %]</label>
            </div>
            [% END %]
        </div>
    </div>

    <button class="btn btn-primary">Import</button>
</form>
[% END %]

<script  id="properties-data" type="application/json">[% no_import ? '[]' : properties_json | html %]</script>

[% WRAPPER includes/infobox.tt %]
    <span class="d-inline-block mb-2">
        A <em>unit</em> is a measurement quantity for an amount of an <em>article</em>. Units can be converted into other units by specifying a
        conversion factor between these.
    </span>
    <span class="d-inline-block mb-2"><em>Shop sections</em> can be used on purchase lists to group similar articles.</span>
    <span class="d-inline-block mb-2">
        An <em>article</em> is an actual item with a defined <em>unit</em>, which can be bought in a supermarket/store. It can be used as ingredient in <em>recipes</em>
        and <em>dishes</em>. An article may also contain information about shelf life and availability.
    </span>
    <span class="d-inline-block mb-2">A <em>recipe</em> is a set of instructions how to prepare and cook a certain <em>dish</em>, including a list of ingredients (<em>articles</em>).</span>
    <span class="d-inline-block mb-2"><em>Shop sections</em> can be used on purchase lists to group similar articles.</span>
    <span class="d-inline-block mb-2">
        A <em>tag</em> is a keyword which can be attached to <em>recipes</em>, <em>dishes</em> and <em>articles</em> to filter them when your search a specific item out of these categories.
        A <em>tag group</em> can be used to organize similar <em>tags</em> together.
    </span>
[% END %]
