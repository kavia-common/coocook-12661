[% title = project.name %]

[% FOREACH day IN days %]

    <div class="card mb-4">
        <div class="card-header">
            <h3 class="m-0">[% display_date(day.date, {html=>1}) %]</h3>
        </div>
        <div class="card-body p-0">
    
    [% FOREACH meal IN day.meals %]
            <div class="row w-100 m-0 border-bottom py-3">
                <div class="col-4">

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <h5 class="m-0">[% meal.name | html %]</h5>
                        <div class="d-flex align-items-center gap-1">
                            <button onclick="editMeal('[% meal.update_url %]', '[% meal.name | html %]', '[% meal.comment | html %]')" class="btn btn-sm btn-outline-secondary">Edit</button>
                            [% IF meal.delete_url %]
                                <form class="inline" method="post" action="[% meal.delete_url %]" name="delete-meal[% meal.id %]">
                                    <input type="submit" name="delete-meal" value="Delete meal" class="btn btn-sm btn-outline-danger">
                                </form>
                            [% ELSIF meal.delete_dishes_url %]
                                <form class="inline" method="post" onsubmit="return confirm('Do you really want to delete all dishes in [% meal.name | html %]?')"
                                action="[% meal.delete_dishes_url %]">
                                    <input type="submit" name="delete-dishes" value="Delete [% meal.dishes.size %] [% meal.dishes.size == 1 ? 'dish' : 'dishes' %]" class="btn btn-sm btn-outline-danger">
                                </form>
                            [% ELSIF meal.prepared_dishes_exist %]
                                <span>([% meal.name %] has pending dishes to prepare. Reorganize them before deleting!)</span>
                            [% END %]
                        </div>
                    </div>
                    <p><i>[% meal.comment %]</i></p>
                    <p>[% meal.dishes.size %] [% meal.dishes.size == 1 ? 'dish' : 'dishes' %]</p>

                </div>

                <div class="col-8">

                    <div class="list-group">
                    [% FOREACH dish IN meal.dishes %]
                        <a class="list-group-item list-group-item-action px-2" href="[% dish.url %]">
                            <i class="material-icons" style="color:#dee2e6;">drag_indicator</i>
                            <span class="text-end" style="display:inline-block; min-width:30px;">[% dish.servings %]</span>
                            <span style="color:#dee2e6;">|</span>
                            <b>[% dish.name | html %]</b>
                        [% IF dish.comment %]
                            <span style="color:#dee2e6;">|</span>
                            <i>[% dish.comment %]</i>
                        [% END %]
                        </a>
                    [% END %]
                        <div class="list-group-item w-100 p-0">
                            <div type="button" class="p-2 w-100 text-secondary d-flex justify-content-center align-items-center" data-bs-toggle="collapse" data-bs-target="#collapseCreateDishOn[% meal.id %]" aria-expanded="false" aria-controls="collapseCreateDishOn[% meal.id %]">Add Dish</div>
                            <div class="collapse p-2" id="collapseCreateDishOn[% meal.id %]">
                                
                                <form action="[% dish_create_url %]" method="post">
                                    <input type="hidden" name="meal" value="[% meal.id %]">
                                    <div class="container mt-2 px-3">
                                        <div class="row">
                                            <input type="text"   name="name" placeholder="name" class="form-control col me-2">
                                            <input type="number" name="servings" value="4" class="form-control col me-2">
                                            <input type="submit" value="Create dish" class="btn btn-sm btn-outline-primary col">
                                        </div>
                                    </div>
                                </form>

                            [% IF recipes.size %]
                                <form action="[% dish_from_recipe_url %]" method="post">
                                    <input type="hidden" name="meal" value="[% meal.id %]">
                                    <div class="container px-3 mt-2">
                                        <div class="row">
                                            <select name="recipe" class="form-control col me-2">
                                        [% FOREACH recipe IN recipes %]
                                                <option value="[% recipe.id %]">[% recipe.name | html %]</option>
                                        [% END %]
                                            </select>
                                            <input type="number" name="servings" value="4" class="form-control col me-2">
                                            <input type="submit" value="Use recipe" class="btn btn-sm btn-outline-primary col">
                                        </div>
                                    </div>
                                </form>
                            [% END %]

                            </div>
                        </div>
                    </div>

                </div>
            </div>

    [% END %]
            <div onclick="createMealOnDate('[% meal_create_url %]', '[% day.date.ymd %]')" type="button" class="createMealOrDishBtn w-100 p-2 text-secondary d-flex justify-content-center align-items-center"><i class="material-icons">add</i></div>
        </div>
    </div>
[% END %]

<button onclick="createMeal('[% meal_create_url %]', '[% default_date.ymd %]')" id="toggleAddDayModal" type="button" class="btn card-header border border-2 w-100 mb-4" style="border-style: dashed !important;">Add meal on another day</button>

<!-- generic modal (functionality in edit.js) -->
<div class="modal fade" id="modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Modal title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="modalForm" action="" method="post">
                <div id="modalBody" class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input id="modalConfirmElement" type="submit" value="" class="btn btn-primary"></input>
                </div>
            </form>
        </div>
    </div>
</div>
